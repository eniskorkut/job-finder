# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and must never be committed.

# --- Core ---------------------------------------------------------------
# SQLite for local development. Swap for a PostgreSQL URL later, the schema
# is written to be portable (no SQLite-only types).
DATABASE_URL=sqlite:///./jobhunter.db

# Secret used to sign/derive session material. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-session-secret

# Fernet key used to encrypt OAuth tokens / bot tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# --- URLs ---------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# --- Deployment-wide OAuth Applications (Gmail & Microsoft Graph) -------
# Google Cloud Console > Credentials > OAuth 2.0 Client ID (Web Application)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Microsoft Entra Admin Center > App registrations (Web Application)
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=consumers

# --- Shared LLM (one key for the whole deployment, never sent to the UI) --
# Any OpenAI-compatible endpoint works: the official DeepSeek API, a gateway
# such as OpenCode Go, a local vLLM/LiteLLM, ...
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4.1-flash

# Concurrency / retry / context limits for the shared LLM
LLM_MAX_CONCURRENCY=3
LLM_TIMEOUT_SECONDS=60
LLM_RETRY_MAX_ATTEMPTS=3
LLM_JSON_MODE=true
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.1
LLM_PROMPT_VERSION=phase3-v1
LLM_CV_CONTEXT_CHARS=3000
LLM_JOB_DESCRIPTION_CHARS=6000
LLM_MAX_ANALYSIS_ATTEMPTS=3

# Some gateways require extra routing headers. OpenCode Go asks for a stable
# session id per conversation; leave LLM_SESSION_ID empty to derive one from
# this installation (stable across restarts).
LLM_SESSION_HEADER=x-opencode-session
LLM_SESSION_ID=
LLM_USER_AGENT=job-finder/1.0
# Optional JSON object of extra headers, e.g. {"X-Organization": "team"}
LLM_EXTRA_HEADERS=

# --- Sessions / security ------------------------------------------------
SESSION_COOKIE_NAME=jh_session
SESSION_TTL_DAYS=14
CSRF_COOKIE_NAME=jh_csrf
CSRF_HEADER_NAME=X-CSRF-Token
COOKIE_SECURE=false

LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# --- Invitations --------------------------------------------------------
INVITATION_TTL_HOURS=48

# --- Storage ------------------------------------------------------------
DATA_DIR=./data

# --- Phase 2: mailbox scan ----------------------------------------------
# First scan window (the whole inbox is never pulled unless requested).
SYNC_INITIAL_WINDOW_DAYS=7
SYNC_INITIAL_MAX_MESSAGES=100
SYNC_MAX_RESULTS_PER_RUN=200
SYNC_BATCH_SIZE=25

# Concurrency: total mailboxes worked in parallel / requests per mailbox.
SYNC_MAX_ACTIVE_MAILBOXES=4
SYNC_MAILBOX_CONCURRENCY=2

# Durable job queue (worker lease, heartbeat, retries).
SYNC_LEASE_SECONDS=180
SYNC_HEARTBEAT_SECONDS=15
SYNC_JOB_TIMEOUT_SECONDS=900
SYNC_MAX_ATTEMPTS=3
WORKER_POLL_SECONDS=2
# WORKER_ID=  # defaults to <hostname>:<pid>

# Outbound HTTP timeouts and retry/backoff (429 / 5xx).
SYNC_HTTP_TIMEOUT_SECONDS=30
SYNC_HTTP_MAX_CONNECTIONS=10
SYNC_RETRY_MAX_ATTEMPTS=4
SYNC_RETRY_BASE_DELAY_SECONDS=1
SYNC_RETRY_MAX_DELAY_SECONDS=30

# Hosts allowed for provider continuation links (SSRF guard).
GRAPH_ALLOWED_HOSTS=graph.microsoft.com
GOOGLE_ALLOWED_HOSTS=www.googleapis.com,gmail.googleapis.com,oauth2.googleapis.com,accounts.google.com
MICROSOFT_ALLOWED_HOSTS=login.microsoftonline.com,login.live.com,graph.microsoft.com

# --- Phase 3: Telegram notifications (per user, token stored encrypted) ---
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_TIMEOUT_SECONDS=20
TELEGRAM_MAX_MESSAGE_CHARS=3500
TELEGRAM_RETRY_MAX_ATTEMPTS=3
TELEGRAM_MAX_NOTIFICATION_ATTEMPTS=3

# --- Phase 3: scheduled scans (runs inside the worker process) -----------
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=60
SCHEDULER_MIN_INTERVAL_HOURS=1
SCHEDULER_MAX_INTERVAL_HOURS=168

# --- Phase 4: Job Discovery, Enrichment & Freshness ---------------------
WEB_SEARCH_PROVIDER=searxng
WEB_SEARCH_SEARXNG_URL=http://localhost:8080
WEB_SEARCH_SEARXNG_SECRET_KEY=
WEB_SEARCH_MAX_CONCURRENCY=2
WEB_SEARCH_MAX_QUERIES_PER_JOB=4
WEB_SEARCH_MAX_RESULTS_PER_QUERY=5
WEB_SEARCH_TIMEOUT_SECONDS=10

WEB_FETCH_MAX_CONCURRENCY=4
WEB_FETCH_TIMEOUT_SECONDS=15
WEB_FETCH_MAX_BYTES=2097152
WEB_FETCH_MAX_REDIRECTS=5

JOB_FRESH_DAYS=3
JOB_AGING_DAYS=7
JOB_STALE_DAYS=14
JOB_MAX_AGE_DAYS=14
JOB_ENRICHMENT_MIN_WORDS=40
