# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and must never be committed.

# --- Core ---------------------------------------------------------------
# SQLite for local development. Swap for a PostgreSQL URL later, the schema
# is written to be portable (no SQLite-only types).
DATABASE_URL=sqlite:///./jobhunter.db

# Secret used to sign/derive session material. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-session-secret

# Fernet key used to encrypt OAuth tokens / bot tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# --- URLs ---------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# --- DeepSeek (shared by every user, used in phase 3) -------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4.1-flash

# --- Sessions / security ------------------------------------------------
SESSION_COOKIE_NAME=jh_session
SESSION_TTL_DAYS=14
CSRF_COOKIE_NAME=jh_csrf
CSRF_HEADER_NAME=X-CSRF-Token
COOKIE_SECURE=false

LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# --- Invitations --------------------------------------------------------
INVITATION_TTL_HOURS=48

# --- Storage ------------------------------------------------------------
DATA_DIR=./data

# --- Phase 2: mailbox scan ----------------------------------------------
# First scan window (the whole inbox is never pulled unless requested).
SYNC_INITIAL_WINDOW_DAYS=7
SYNC_INITIAL_MAX_MESSAGES=100
SYNC_MAX_RESULTS_PER_RUN=200
SYNC_BATCH_SIZE=25

# Concurrency: total mailboxes worked in parallel / requests per mailbox.
SYNC_MAX_ACTIVE_MAILBOXES=4
SYNC_MAILBOX_CONCURRENCY=2

# Durable job queue (worker lease, heartbeat, retries).
SYNC_LEASE_SECONDS=180
SYNC_HEARTBEAT_SECONDS=15
SYNC_JOB_TIMEOUT_SECONDS=900
SYNC_MAX_ATTEMPTS=3
WORKER_POLL_SECONDS=2
# WORKER_ID=  # defaults to <hostname>:<pid>

# Outbound HTTP timeouts and retry/backoff (429 / 5xx).
SYNC_HTTP_TIMEOUT_SECONDS=30
SYNC_HTTP_MAX_CONNECTIONS=10
SYNC_RETRY_MAX_ATTEMPTS=4
SYNC_RETRY_BASE_DELAY_SECONDS=1
SYNC_RETRY_MAX_DELAY_SECONDS=30

# Hosts allowed for provider continuation links (SSRF guard).
GRAPH_ALLOWED_HOSTS=graph.microsoft.com
GOOGLE_ALLOWED_HOSTS=www.googleapis.com,gmail.googleapis.com,oauth2.googleapis.com,accounts.google.com
MICROSOFT_ALLOWED_HOSTS=login.microsoftonline.com,login.live.com,graph.microsoft.com
